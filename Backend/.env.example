# ==============================================================================
# PulseTrade Backend - Environment Variables Configuration
# Copy this file to .env and configure the values for your environment.
# ==============================================================================

# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration
# MongoDB Connection String (Atlas URI or Local Replica Set URI)
# Local Replica Set Example: mongodb://127.0.0.1:27017/pulsetrade?replicaSet=rs0&directConnection=true
ATLASDB_URL=mongodb+srv://<username>:<password>@cluster.mongodb.net/pulsetrade?appName=Cluster0
DB_NAME=pulsetrade

# Authentication Token Secret Key (JWT)
TOKEN_KEY=your_secure_jwt_secret_key_here

# Razorpay Payment Gateway Keys (Test / Live)
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_secret_key_here

# CORS / Origin Configuration
# Frontend (Marketing & Auth) and Dashboard client URLs
FRONTEND_URL=http://localhost:5174
DASHBOARD_URL=http://localhost:5173

# Comma-separated list of additional allowed CORS origins (e.g. for Production / Staging)
ALLOWED_ORIGINS=http://localhost:5174,http://localhost:5173
